generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

enum AppRole {
  USER
  STAFF
  ADMIN
}

model Category {
  id          String                      @id @default(uuid())
  parentId    String?                     @map("parent_id")
  name        String
  slug        String                      @unique
  description String?
  active      Boolean                     @default(true)
  sortOrder   Int                         @default(0) @map("sort_order")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  parent      Category?                   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]                  @relation("CategoryTree")
  products    Product[]
  variants    ProductVariant[]
  templates   CategoryAttributeTemplate[]

  @@index([parentId], map: "idx_categories_parent_id")
  @@index([active, sortOrder], map: "idx_categories_active_sort_order")
  @@map("categories")
}

model Brand {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  logoUrl   String?          @map("logo_url")
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  products  Product[]
  variants  ProductVariant[]

  @@index([active], map: "idx_brands_active")
  @@map("brands")
}

model Product {
  id           String                       @id @default(uuid())
  categoryId   String                       @map("category_id")
  brandId      String?                      @map("brand_id")
  name         String
  slug         String                       @unique
  description  String?
  datasheetUrl String?                      @map("datasheet_url")
  active       Boolean                      @default(true)
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")
  category     Category                     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand        Brand?                       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  attributes   ProductAttributeDefinition[]

  @@index([categoryId, active], map: "idx_products_category_active")
  @@index([brandId, active], map: "idx_products_brand_active")
  @@map("products")
}

model ProductVariant {
  id                     String                  @id @default(uuid())
  productId              String                  @map("product_id")
  categoryId             String                  @map("category_id")
  brandId                String?                 @map("brand_id")
  sku                    String                  @unique
  manufacturerPartNumber String?                 @map("manufacturer_part_number")
  name                   String
  slug                   String                  @unique
  price                  Decimal                 @db.Decimal(12, 2)
  stockQuantity          Int                     @default(0) @map("stock_quantity")
  unit                   String?
  minOrderQuantity       Int                     @default(1) @map("min_order_quantity")
  score                  Decimal                 @default(0) @db.Decimal(12, 4)
  viewCount              Int                     @default(0) @map("view_count")
  orderCount             Int                     @default(0) @map("order_count")
  specSnapshot           Json?                   @map("spec_snapshot")
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  category               Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  attributeValues        VariantAttributeValue[]

  @@index([active, score(sort: Desc)], map: "idx_variants_active_score")
  @@index([categoryId, score(sort: Desc)], map: "idx_variants_category_score")
  @@index([brandId, score(sort: Desc)], map: "idx_variants_brand_score")
  @@index([productId], map: "idx_variants_product_id")
  @@index([manufacturerPartNumber], map: "idx_variants_mpn")
  @@map("product_variants")
}

model CategoryAttributeTemplate {
  id                String                       @id @default(uuid())
  categoryId        String                       @map("category_id")
  name              String
  code              String
  dataType          AttributeDataType            @map("data_type")
  unit              String?
  isFilterable      Boolean                      @default(false) @map("is_filterable")
  isSearchable      Boolean                      @default(false) @map("is_searchable")
  isRequired        Boolean                      @default(false) @map("is_required")
  sortOrder         Int                          @default(0) @map("sort_order")
  active            Boolean                      @default(true)
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  category          Category                     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productAttributes ProductAttributeDefinition[]

  @@unique([categoryId, code], map: "uq_category_attribute_templates_category_id_code")
  @@index([categoryId, active, sortOrder], map: "idx_category_attribute_templates_category_active_sort")
  @@map("category_attribute_templates")
}

model ProductAttributeDefinition {
  id                 String                     @id @default(uuid())
  productId          String                     @map("product_id")
  categoryTemplateId String?                    @map("category_template_id")
  name               String
  code               String
  dataType           AttributeDataType          @map("data_type")
  unit               String?
  isFilterable       Boolean                    @default(false) @map("is_filterable")
  isSearchable       Boolean                    @default(false) @map("is_searchable")
  isRequired         Boolean                    @default(false) @map("is_required")
  sortOrder          Int                        @default(0) @map("sort_order")
  active             Boolean                    @default(true)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  product            Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryTemplate   CategoryAttributeTemplate? @relation(fields: [categoryTemplateId], references: [id], onDelete: SetNull)
  values             VariantAttributeValue[]

  @@unique([productId, code], map: "uq_product_attribute_definitions_product_id_code")
  @@index([productId, active, sortOrder], map: "idx_product_attribute_definitions_product_active_sort")
  @@index([code], map: "idx_product_attribute_definitions_code")
  @@map("product_attribute_definitions")
}

model VariantAttributeValue {
  id                           String                     @id @default(uuid())
  variantId                    String                     @map("variant_id")
  productAttributeDefinitionId String                     @map("product_attribute_definition_id")
  valueText                    String?                    @map("value_text")
  valueNumber                  Decimal?                   @map("value_number") @db.Decimal(18, 4)
  valueBoolean                 Boolean?                   @map("value_boolean")
  valueEnum                    String?                    @map("value_enum")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")
  variant                      ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productAttributeDefinition   ProductAttributeDefinition @relation(fields: [productAttributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([variantId, productAttributeDefinitionId], map: "uq_variant_attribute_values_variant_id_attribute_id")
  @@index([variantId], map: "idx_variant_attribute_values_variant_id")
  @@index([productAttributeDefinitionId, valueText], map: "idx_variant_attribute_values_attr_text")
  @@index([productAttributeDefinitionId, valueNumber], map: "idx_variant_attribute_values_attr_number")
  @@map("variant_attribute_values")
}

model User {
  id               String    @id @default(uuid())
  fullName         String?   @map("full_name")
  dateOfBirth      DateTime? @map("date_of_birth")
  email            String    @unique
  phoneNumber      String?   @unique @map("phone_number")
  passwordHash     String    @map("password_hash")
  role             AppRole   @default(USER)
  active           Boolean   @default(true)
  refreshTokenHash String?   @map("refresh_token_hash")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([role, active], map: "idx_users_role_active")
  @@map("users")
}
